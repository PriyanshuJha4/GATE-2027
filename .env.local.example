NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# --- Cloud sync bridge (laptop -> Supabase Storage -> phone), see README ---
# Server-side only (NEVER prefix with NEXT_PUBLIC_). Pick a long random passphrase; you type it once on laptop and phone.
SYNC_ACCESS_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# optional, default gate-sync (private bucket, created automatically)
SYNC_BUCKET=gate-sync
